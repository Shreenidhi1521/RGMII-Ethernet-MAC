`timescale 1ns/1ps
 
module tb_rgmii_mac;
    reg clk125 = 0;
    reg clk25  = 0;
    reg clk2_5 = 0;
 
    always #4   clk125 = ~clk125;   // toggle every 4ns  -> 8ns period   = 125 MHz
    always #20  clk25  = ~clk25;    // toggle every 20ns -> 40ns period  = 25 MHz
    always #200 clk2_5 = ~clk2_5;   // toggle every 200ns-> 400ns period = 2.5 MHz
 
    reg        rst_n     = 0;        // held low (reset) at the very start
    reg [1:0]  speed_sel = 2'b10;    // 2'b10=1000M, 2'b01=100M, 2'b00=10M
 
    initial begin
        rst_n = 0;
        #100;         // hold reset for 100ns, long enough for every clock to tick
        rst_n = 1;    // release reset, design starts running
    end
    wire cur_clk = (speed_sel == 2'b10) ? clk125 :
                   (speed_sel == 2'b01) ? clk25  :
                                           clk2_5;
 
    reg  [7:0] mac_txd   = 8'h00;
    reg        mac_tx_en = 1'b0;
    reg        mac_tx_er = 1'b0;
 
    wire [7:0] mac_rxd;
    wire        mac_rx_dv;
    wire        mac_rx_er;
 
    wire        rgmii_txc;
    wire [3:0]  rgmii_txd;
    wire        rgmii_tx_ctl;
 
    wire        rgmii_rxc    = rgmii_txc;      // loopback
    wire [3:0]  rgmii_rxd    = rgmii_txd;      // loopback
    wire        rgmii_rx_ctl = rgmii_tx_ctl;   // loopback
 
    rgmii_mac_top dut (
        .clk125       (clk125),
        .clk25        (clk25),
        .clk2_5       (clk2_5),
        .rst_n        (rst_n),
        .speed_sel    (speed_sel),
        .mac_txd      (mac_txd),
        .mac_tx_en    (mac_tx_en),
        .mac_tx_er    (mac_tx_er),
        .mac_rxd      (mac_rxd),
        .mac_rx_dv    (mac_rx_dv),
        .mac_rx_er    (mac_rx_er),
        .rgmii_txc    (rgmii_txc),
        .rgmii_txd    (rgmii_txd),
        .rgmii_tx_ctl (rgmii_tx_ctl),
        .rgmii_rxc    (rgmii_rxc),
        .rgmii_rxd    (rgmii_rxd),
        .rgmii_rx_ctl (rgmii_rx_ctl)
    );
 
   
    reg [7:0] expected_q [0:255];
    reg       er_q       [0:255];   // the rx_er value we actually saw for each received byte
    integer   wr_ptr     = 0;
    integer   rd_ptr     = 0;
    integer   pass_count = 0;
    integer   fail_count = 0;
 
   
    always @(posedge mac_rx_dv) begin
        if (mac_rxd !== expected_q[rd_ptr]) begin
            $display("FAIL @ t=%0t : speed_sel=%b expected 0x%02h, got 0x%02h",
                      $time, speed_sel, expected_q[rd_ptr], mac_rxd);
            fail_count = fail_count + 1;
        end else begin
            $display("PASS @ t=%0t : speed_sel=%b byte 0x%02h received correctly",
                      $time, speed_sel, mac_rxd);
            pass_count = pass_count + 1;
        end
        er_q[rd_ptr] = mac_rx_er;
        rd_ptr       = rd_ptr + 1;
    end
 
    task send_byte(input [7:0] data, input err);
        begin
            @(negedge cur_clk);
            mac_txd            = data;
            mac_tx_en          = 1'b1;
            mac_tx_er          = err;
            expected_q[wr_ptr] = data;
            wr_ptr             = wr_ptr + 1;
 
            @(negedge cur_clk);
            mac_tx_en = 1'b0;   // done -- go back to "no data" until next call
            mac_tx_er = 1'b0;
        end
    endtask
 
    initial begin
        // Set up waveform dumping so you can inspect signals in GTKWave.
        $dumpfile("tb_rgmii_mac.vcd");
        $dumpvars(0, tb_rgmii_mac);
 
        // Wait for reset to clear.
        wait (rst_n == 1'b1);
        @(posedge cur_clk);
 
        // ---- Test at 1000 Mbps (speed_sel = 2'b10) ----
        speed_sel = 2'b10;
        repeat (3) @(posedge cur_clk);   // let the clock mux settle
        $display("\n--- Testing at 1000 Mbps ---");
        send_byte(8'hA5, 1'b0);
        send_byte(8'h3C, 1'b0);
        send_byte(8'hFF, 1'b0);
        send_byte(8'h00, 1'b0);
        repeat (5) @(posedge cur_clk);   // let the last byte finish arriving
 
        // ---- Test at 100 Mbps (speed_sel = 2'b01) ----
        speed_sel = 2'b01;
        repeat (3) @(posedge cur_clk);
        $display("\n--- Testing at 100 Mbps ---");
        send_byte(8'h11, 1'b0);
        send_byte(8'h22, 1'b0);
        send_byte(8'h99, 1'b0);
        repeat (5) @(posedge cur_clk);
 
        // ---- Test at 10 Mbps (speed_sel = 2'b00) ----
        speed_sel = 2'b00;
        repeat (3) @(posedge cur_clk);
        $display("\n--- Testing at 10 Mbps ---");
        send_byte(8'h5A, 1'b0);
        send_byte(8'hC3, 1'b0);
        repeat (5) @(posedge cur_clk);
 
        $display("\n--- Testing tx_er / rx_er error flag ---");
        send_byte(8'hDE, 1'b1);
        repeat (5) @(posedge cur_clk);   // give the byte time to arrive
        if (er_q[rd_ptr-1] !== 1'b1)
            $display("FAIL: expected mac_rx_er to be asserted for the errored byte");
        else
            $display("PASS: mac_rx_er correctly asserted for the errored byte");
 
        // ---- Final summary ----
        repeat (5) @(posedge cur_clk);
        $display("\n===================================");
        $display(" TEST SUMMARY: %0d passed, %0d failed", pass_count, fail_count);
        $display("===================================");
 
        if (fail_count == 0)
            $display("ALL TESTS PASSED");
        else
            $display("SOME TESTS FAILED -- check log above");
 
        $finish;
    end
 
    initial begin
        #1000000;   // 1,000,000 ns = 1 ms of simulated time
        $display("ERROR: testbench timed out -- a byte never arrived");
        $finish;
    end
 
endmodule
 
